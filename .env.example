# Bridle web app: testnet only. Copy to .env.local and fill in.
NEXT_PUBLIC_NEAR_NETWORK=testnet
# The account you deployed the contract to (see contract/README.md)
NEXT_PUBLIC_BRIDLE_CONTRACT=
# Read-only RPC. Any testnet RPC works.
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
