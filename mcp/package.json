{
  "name": "bridle-mcp",
  "version": "0.1.0",
  "description": "MCP server for Bridle: lets an AI agent read its spending rules, check a payment, and propose one. Owner actions are deliberately not exposed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mofifoluwa-ade/Bridle.git",
    "directory": "mcp"
  },
  "homepage": "https://bridle-agent.vercel.app/mcp",
  "bugs": {
    "url": "mailto:usebridle@gmail.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "near",
    "payments",
    "policy",
    "spending-limits",
    "bridle"
  ],
  "type": "module",
  "bin": {
    "bridle-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "near-api-js": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
