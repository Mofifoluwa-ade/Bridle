{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bridle": {
      "type": "streamable-http",
      "url": "https://bridle-agent.vercel.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://bridle-agent.vercel.app/api/oauth/register",
            "baseScopes": [
              "agent"
            ]
          }
        }
      }
    }
  }
}
